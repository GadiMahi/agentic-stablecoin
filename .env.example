# Automated response — copy to `.env` and fill in whichever channels you want.
# Nothing here is required: console and browser notifications work with no setup.
# Load with:  Get-Content .env | ForEach-Object { ... }   (PowerShell)
#         or: export $(grep -v '^#' .env | xargs)          (bash)

# --- Discord / Slack webhook -------------------------------------------------
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
# Slack:   api.slack.com/messaging/webhooks
# STHIRA_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# --- Email over SMTP ---------------------------------------------------------
# Gmail needs an App Password (Google Account > Security > 2-Step Verification
# > App passwords). Your normal account password will not work.
# STHIRA_SMTP_HOST=smtp.gmail.com
# STHIRA_SMTP_PORT=587
# STHIRA_SMTP_USER=you@gmail.com
# STHIRA_SMTP_PASS=abcd efgh ijkl mnop
# STHIRA_SMTP_TO=you@gmail.com,someone.else@example.com

# --- Escalation floor --------------------------------------------------------
# WARN (default) or CRITICAL
# STHIRA_MIN_LEVEL=WARN
